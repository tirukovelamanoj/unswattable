{
  // Static assets only: no Worker script, no "main" entry. Cloudflare serves the
  // files directly from its edge, which is all this project needs since the
  // simulation runs entirely in the visitor's browser.
  "name": "unswattable",
  "compatibility_date": "2026-09-16",
  "assets": {
    // The site files live at the repo root next to index.html.
    "directory": ".",
    "not_found_handling": "404-page"
  }
}
